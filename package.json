{
  "name": "extension-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:scripts": "esbuild scripts/post-migrate.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --external:better-sqlite3 --outfile=deploy/dist/post-migrate.cjs && esbuild worker/main.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --external:better-sqlite3 --outfile=deploy/dist/worker.cjs && esbuild scripts/keys.ts --bundle --platform=node --target=node22 --format=cjs --external:sharp --external:better-sqlite3 --outfile=deploy/dist/keys.cjs",
    "build:cli": "esbuild packages/cli/src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=packages/cli/dist/cli.js --external:sharp --external:better-sqlite3 && esbuild action/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=action/dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "iron-session": "^8.0.4",
    "jose": "6.2.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "18.0.14",
    "next": "16.2.1",
    "nodemailer": "10.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.7",
    "sharp": "0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
