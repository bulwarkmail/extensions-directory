# Database (SQLite)
DATABASE_PATH=data/extensions.db

# Session secrets (generate with: openssl rand -hex 32)
AUTHOR_SESSION_SECRET=change-me-author-session-secret-min-32-chars!!
ADMIN_SESSION_SECRET=change-me-admin-session-secret-min-32-chars!!!

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Public URL
NEXT_PUBLIC_SITE_URL=https://extensions.bulwarkmail.org

# Storage
UPLOADS_DIR=data/uploads

# Node environment
NODE_ENV=production

# Publishing rework (see deploy/server-setup.sh for production values)
TOKEN_PEPPER=change-me-random-hex
IP_HASH_SALT=change-me-random-hex
# Build runner: local (Docker here), ssh (the build VM), off (no builds)
SANDBOX_RUNNER=local
# Worker only: the online signing key and the root keys trusted for keyrings
# SIGNING_KEY_FILE=keys/signing.pem
EXTENSIONS_ROOT_KEYS=SyGlNKHBY4T7Z7BmDP80G8Eh58yn6W32SpKUHpRzHk4=
# Email notifications (worker)
# SMTP_HOST=mail.rath.li
# SMTP_PORT=465
# SMTP_USER=noreply@bulwarkmail.org
# SMTP_PASSWORD=
MAIL_FROM="Bulwark Extensions <noreply@bulwarkmail.org>"
