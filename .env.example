# Database (SQLite)
DATABASE_PATH=data/extensions.db

# Session secret, required in production: at least 32 random characters of
# your own, or the app answers every request with an error. Generate it with:
# openssl rand -hex 32
AUTHOR_SESSION_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Public URL
NEXT_PUBLIC_SITE_URL=https://extensions.bulwarkmail.org

# Storage
UPLOADS_DIR=data/uploads

# Node environment
NODE_ENV=production

# Publishing rework (see deploy/server-setup.sh for production values)
# Key for the stored API token hashes and key for the stored address hashes.
# Both are required in production, like the session secret. Generate each
# with: openssl rand -hex 32
TOKEN_PEPPER=
IP_HASH_SALT=
# Build runner: local (Docker here), ssh (the build VM), off (no builds)
SANDBOX_RUNNER=local
# Worker only: the online signing key and the root keys trusted for keyrings
# SIGNING_KEY_FILE=keys/signing.pem
EXTENSIONS_ROOT_KEYS=SyGlNKHBY4T7Z7BmDP80G8Eh58yn6W32SpKUHpRzHk4=
# Email notifications (worker)
# SMTP_HOST=mail.rath.li
# SMTP_PORT=465
# SMTP_USER=noreply@bulwarkmail.org
# SMTP_PASSWORD=
MAIL_FROM="Bulwark Extensions <noreply@bulwarkmail.org>"
