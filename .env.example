# Database (SQLite)
DATABASE_PATH=data/extensions.db

# Session secrets (generate with: openssl rand -hex 32)
AUTHOR_SESSION_SECRET=change-me-author-session-secret-min-32-chars!!
ADMIN_SESSION_SECRET=change-me-admin-session-secret-min-32-chars!!!

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Public URL
NEXT_PUBLIC_SITE_URL=https://extensions.bulwarkmail.org

# Storage
UPLOADS_DIR=data/uploads

# Node environment
NODE_ENV=production
